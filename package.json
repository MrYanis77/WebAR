{
  "name": "webar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --clear-screen=false api/src/serveur.ts",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.api.json",
    "start": "tsx api/src/serveur.ts",
    "creer-agent": "tsx api/scripts/creer-agent.ts",
    "prisma:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "test": "vitest run",
    "lint": "oxlint",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "dev:mobile": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"vite --mode mobile\"",
    "combiner-animations": "tsx api/scripts/combiner-animations.ts",
    "changer-mot-de-passe": "tsx api/scripts/changer-mot-de-passe.ts"
  },
  "dependencies": {
    "@8thwall/engine-binary": "1.0.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@google/model-viewer": "^4.4.0",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "altcha": "^3.6.0",
    "altcha-lib": "^2.8.0",
    "argon2": "^0.45.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.1.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.19.0",
    "file-type": "^22.3.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "helmet": "^8.3.0",
    "i18next": "^27.1.2",
    "maplibre-gl": "^5.24.1",
    "mariadb": "^3.5.5",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "p-queue": "^10.0.0",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router": "^7.18.5",
    "sharp": "^0.35.5",
    "three": "^0.183.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/geojson": "^7946.0.16",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.7",
    "oxlint": "^1.89.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": "24.x"
  }
}
