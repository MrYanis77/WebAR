# Copier en .env puis adapter. Base MySQL/MariaDB créée avec database/montbeliard_webar.sql
DATABASE_URL="mysql://utilisateur:motdepasse@127.0.0.1:3306/webar"
API_PORT=3000
# Domaine encodé dans les QR codes des affiches (BNF-18)
DOMAINE_APPLICATION=https://experiences.montbeliard.fr
URL_FRONT=http://localhost:5173
# Facultatif (npm run dev:mobile) : adresse encodée dans les QR codes si la détection automatique de
# l'IP du PC se trompe, ex. URL_RESEAU=https://10.14.28.115:5173
# URL_RESEAU=
DOSSIER_UPLOADS=uploads
# Secrets : 64 caractères hexadécimaux aléatoires chacun
SESSION_SECRET=
CSRF_SECRET=
ALTCHA_HMAC=
ALTCHA_HMAC_CLE=
# Mails : Mailpit en local (SMTP 1025, interface http://localhost:8025)
SMTP_HOTE=127.0.0.1
SMTP_PORT=1025
MAIL_EXPEDITEUR="Mindi <ne-pas-repondre@montbeliard.fr>"

# Double authentification des agents par code envoyé par mail (désactivée provisoirement)
DOUBLE_AUTHENTIFICATION=false
