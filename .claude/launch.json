{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "webar",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "webar-mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:mobile"
      ],
      "port": 5173,
      "url": "https://localhost:5173"
    },
    {
      "name": "webar-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    },
    {
      "name": "webar-build",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
